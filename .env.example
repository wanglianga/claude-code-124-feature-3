# ===== 应用配置 =====
PORT=8080
# compose 内部连接串（服务名访问，不发布到宿主）
DATABASE_URL=postgres://flower:flower@db:5432/flowermarket?sslmode=disable
REDIS_ADDR=redis:6379

# 普通订单支付时限（分钟），超时自动取消并释放锁货
PAYMENT_TIMEOUT_MIN=30
# 节日预售锁货支付时限（小时）
PRESALE_PAYMENT_HOURS=72
# 后台清扫周期（秒）：结拍/超时取消/逾期标记/报损
SWEEP_INTERVAL_SEC=15
# 冷库费（元/扎/小时），结算时按入库时长计
STORAGE_FEE_PER_BUNDLE_HOUR=0.2
# 账期逾期日罚息比例（结算时计入账期扣款，封顶 20%）
CREDIT_DAILY_PENALTY_RATE=0.005
# 临时保温超多少小时未入库触发冷库/管理方提醒
HOLDING_MAX_HOURS=6
# 首次启动是否写入演示数据
SEED_DEMO=true

# ===== PostgreSQL（compose 内部） =====
POSTGRES_USER=flower
POSTGRES_PASSWORD=flower
POSTGRES_DB=flowermarket

# ===== 宿主发布端口（验证时由环境变量提供） =====
CC_PUBLISH_PORT=8080
